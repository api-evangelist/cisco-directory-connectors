  "info": {
    "_postman_id": "4e2488a8-a616-4061-aa62-aba1b88af4da",
    "name": "Cisco Directory Connectors API (via Webex & ) Groups People API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Cisco Directory Connectors synchronize Active Directory or LDAP user\nand group data into Cisco Webex / Control Hub. Programmatic management\nis performed through the Webex People and Groups REST APIs hosted at\nwebexapis.com/v1. Authentication uses OAuth 2.0 access tokens issued\nby the Webex developer hub.\n\n\nContact Support:\n Name: Cisco DevNet",
      "type": "text/plain"
    }
  }
